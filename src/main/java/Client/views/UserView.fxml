                            <TextField fx:id="txtOrderSearch" prefWidth="220" promptText="Tìm theo mã đơn..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                        </HBox>
                        <TableView fx:id="tableOrderHistory" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colOrderId" prefWidth="120" text="Mã đơn" />
