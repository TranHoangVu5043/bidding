<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F4F7F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controller.UserController">

    <!-- ═══════════════════ TOP NAVBAR ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: white;                      -fx-border-color: #E0E0E0;                      -fx-border-width: 0 0 1 0;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <children>
                <!-- Logo -->
                <Label style="-fx-font-weight: bold; -fx-font-size: 22;" text="🔨 AUCTION" textFill="#0066CC">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>

                <!-- Search bar -->
                <HBox alignment="CENTER" maxWidth="460.0" spacing="0" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20; -fx-padding: 0 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 14; -fx-text-fill: #9CA3AF;" text="🔍" />
                    <TextField fx:id="txtSearch" onAction="#handleSearch" promptText="Tìm kiếm sản phẩm, phiên đấu giá..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 8 8;" HBox.hgrow="ALWAYS" />
               <padding>
                  <Insets right="30.0" />
               </padding>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                         <!-- Cart button -->
                <StackPane>
                    <Button fx:id="btnCartTop" onAction="#handleCart" prefHeight="40" prefWidth="40" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20;                                    -fx-cursor: hand; -fx-font-size: 16;" text="🛒" />
                    <Label fx:id="lblCartCount" mouseTransparent="true" style="-fx-background-color: #D32F2F; -fx-text-fill: white;                                   -fx-font-size: 9; -fx-font-weight: bold;                                   -fx-background-radius: 8; -fx-padding: 1 4;" text="0" translateX="4" translateY="-4" StackPane.alignment="TOP_RIGHT" />
                </StackPane>

                <!-- Notification button -->
                <StackPane>
               <Button fx:id="btnNotifTop" mnemonicParsing="false" prefHeight="39.0" prefWidth="43.0" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20; -fx-cursor: hand; -fx-background-size: 16;" text="🔔 ">
                  <font>
                     <Font size="16.0" />
                  </font>
                  <contextMenu>
                     <ContextMenu height="300.0" maxWidth="400.0" prefWidth="400.0" style="-fx-translate-y: 15; -fx-translate-x: -200;" width="300.0">
                       <items>
                           <MenuItem mnemonicParsing="false">
                              <graphic>
                                 <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="20.0">
                                    <children>
                                       <Label minWidth="-Infinity" style="-fx-font-size: 13;" text="Đơn hàng #ORD-0042 đã được giao" textFill="#3f2f2f" />
                                       <Label minWidth="-Infinity" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="5 phút trước">
                                          <HBox.margin>
                                             <Insets right="30.0" />
                                          </HBox.margin>
                                       </Label>
                                    </children>
                                    <padding>
                                       <Insets right="40.0" />
                                    </padding>
                                 </HBox>
                              </graphic>
                           </MenuItem>
                       </items>
                     </ContextMenu>
                  </contextMenu>
               </Button>
                    <Label fx:id="lblNotifCount" mouseTransparent="true" style="-fx-background-color: #f97316; -fx-text-fill: white;                                   -fx-font-size: 9; -fx-font-weight: bold;                                   -fx-background-radius: 8; -fx-padding: 1 4;" text="3" translateX="4" translateY="-4" StackPane.alignment="TOP_RIGHT" />
                </StackPane>

                <!-- Avatar + Username -->
                <HBox alignment="CENTER" spacing="8" style="-fx-cursor: hand;">
                    <Circle fx:id="avatarCircle" fill="#0066CC" radius="18.0" stroke="#BBDEFB" strokeWidth="2" />
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label fx:id="lblUsername" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Nguyen Van A" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #9CA3AF;" text="Member" />
                    </VBox>
                </HBox>
            </children>
        </HBox>
    </top>

    <!-- ═══════════════════ LEFT SIDEBAR ═══════════════════ -->
    <left>
        <VBox prefWidth="200.0" spacing="10.0" style="-fx-background-color: #1a3a5a;">
            <padding><Insets bottom="20" left="10" right="10" top="20" /></padding>
            <children>

                <!-- User info block -->
                <VBox alignment="CENTER" spacing="6.0" style="-fx-padding: 10 0 16 0;">
                    <Circle fill="#0066CC" radius="32.0" stroke="#4A90D9" strokeWidth="2.5" />
                    <Label fx:id="lblSidebarName" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Nguyen Van A" textFill="WHITE" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #4CAF50;" text="● Online" />
                </VBox>

                <Separator opacity="0.2" />

                <!-- Nav buttons -->
                <Button fx:id="btnDashBoard" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDashBoard" style="-fx-background-color: #0066CC; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🏠  Dashboard" textFill="WHITE">
                    <VBox.margin><Insets top="8" /></VBox.margin>
                </Button>
            <Button fx:id="btnAuction" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAuction" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🔨  Auction" textFill="#CBD5E1" />

                <Button fx:id="btnOrderHistory" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleOrderHistory" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="📦  Order History" textFill="#CBD5E1" />

                <Button fx:id="btnProfile" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleProfile" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="👤  Profile" textFill="#CBD5E1" />

                <Button fx:id="btnSettings" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSettings" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="⚙  Settings" textFill="#CBD5E1" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.2" />

                <Button fx:id="btnSignOut" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignOut" style="-fx-background-color: #C0392B; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-padding: 10 15; -fx-cursor: hand;" text="🚪  Sign Out" textFill="WHITE">
                    <VBox.margin><Insets top="8" /></VBox.margin>
                </Button>

            </children>
        </VBox>
    </left>

    <!-- ═══════════════════ CENTER CONTENT (TabPane) ═══════════════════ -->
    <center>
        <TabPane fx:id="mainTabPane" style="-fx-background-color: transparent; -fx-tab-min-width: 0; -fx-tab-max-width: 0;" tabClosingPolicy="UNAVAILABLE">
         <Tab fx:id="tabDashboard" text="">
            <content>
               <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                  <content>
                     <VBox spacing="25.0" style="-fx-padding: 25;">
                        <children>
                           <HBox spacing="15">
                              <children>
                                 <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                                      -fx-padding: 16;">
                                    <children>
                                       <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đang đấu giá" />
                                       <Label fx:id="lblActiveBids" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #0066CC;" text="2 phiên" />
                                    </children>
                                 </VBox>
                                 <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                                      -fx-padding: 16;">
                                    <children>
                                       <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đã thắng" />
                                       <Label fx:id="lblWonAuctions" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #f97316;" text="5 phiên" />
                                    </children>
                                 </VBox>
                              </children>
                           </HBox>
                           <VBox spacing="12">
                              <children>
                                 <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                       <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🔨 Sàn Đấu Giá" />
                                       <Region HBox.hgrow="ALWAYS" />
                                       <ComboBox fx:id="cmbFilter" prefWidth="140" promptText="Lọc theo..." style="-fx-background-radius: 8;" />
                                       <Button fx:id="btnRefreshAuctions" onAction="#handleRefreshAuctions" style="-fx-background-color: #E0F2FE; -fx-text-fill: #0066CC;                                                            -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 7 14;" text="🔄 Làm mới" />
                                    </children>
                                 </HBox>
                                 <FlowPane fx:id="auctionFlowPane" hgap="18.0" vgap="18.0" />
                              </children>
                           </VBox>
                        </children>
                     </VBox>
                  </content>
               </ScrollPane>
            </content>
         </Tab>

            <!-- ───── TAB 4: ORDER HISTORY ───── -->
            <Tab fx:id="tabOrderHistory" text="">
                <VBox spacing="15" style="-fx-padding: 25;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="📦 Lịch Sử Đơn Hàng" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <ComboBox fx:id="cbStatusFilter" prefWidth="160" promptText="Trạng thái" style="-fx-background-radius: 8;" />
                            <TextField fx:id="txtSearchField" prefWidth="220" promptText="Tìm theo mã đơn..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                        </HBox>
                        <TableView fx:id="tableOrderHistory" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="120" text="Mã đơn" />
                                <TableColumn fx:id="colDate" prefWidth="130" text="Ngày đặt" />
                                <TableColumn fx:id="colProduct" prefWidth="200" text="Sản phẩm" />
                                <TableColumn fx:id="colTotal" prefWidth="130" text="Tổng tiền" />
                                <TableColumn fx:id="colStatus" prefWidth="120" text="Trạng thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </Tab>
         <Tab fx:id="tabNotification" text="">
            <content>
               <VBox spacing="15" style="-fx-padding: 25;">
                  <children>
                     <HBox alignment="CENTER_LEFT" spacing="10">
                        <children>
                           <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🔔 Thông Báo" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Button fx:id="btnMarkAllRead" onAction="#handleMarkAllRead" style="-fx-background-color: transparent; -fx-text-fill: #0066CC;                                            -fx-font-size: 12; -fx-cursor: hand;" text="Đánh dấu tất cả đã đọc" />
                        </children>
                     </HBox>
                     <HBox spacing="8">
                        <children>
                           <Button fx:id="btnNotifAll" onAction="#filterNotifAll" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                            -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Tất cả" />
                           <Button fx:id="btnNotifUnread" onAction="#filterNotifUnread" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                            -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Chưa đọc" />
                           <Button fx:id="btnNotifAuction" onAction="#filterNotifAuction" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                            -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Đấu giá" />
                           <Button fx:id="btnNotifOrder" onAction="#filterNotifOrder" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                            -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Đơn hàng" />
                        </children>
                     </HBox>
                     <ScrollPane fitToWidth="true" style="-fx-background: transparent;" VBox.vgrow="ALWAYS">
                        <content>
                           <VBox fx:id="notificationList" spacing="8" style="-fx-padding: 5;">
                              <children>
                                 <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-padding: 12;">
                                    <children>
                                       <Label style="-fx-font-size: 20;" text="🔨" />
                                       <VBox spacing="3" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Bạn đang dẫn đầu phiên đấu giá!" />
                                             <Label style="-fx-font-size: 12; -fx-text-fill: #4B5563;" text="Laptop Dell XPS 15 - Giá hiện tại: 12,000,000 ₫" />
                                          </children>
                                       </VBox>
                                       <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="5 phút trước" />
                                    </children>
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10;                                                  -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-padding: 12;">
                                    <children>
                                       <Label style="-fx-font-size: 20;" text="📦" />
                                       <VBox spacing="3" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label style="-fx-font-size: 13;" text="Đơn hàng #ORD-0042 đã được giao" />
                                             <Label style="-fx-font-size: 12; -fx-text-fill: #4B5563;" text="Vui lòng xác nhận đã nhận hàng" />
                                          </children>
                                       </VBox>
                                       <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="1 giờ trước" />
                                    </children>
                                 </HBox>
                              </children>
                           </VBox>
                        </content>
                     </ScrollPane>
                  </children>
               </VBox>
            </content>
         </Tab>
         <Tab fx:id="tabProfile" text="">
            <content>
               <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                  <content>
                     <VBox spacing="20" style="-fx-padding: 25; -fx-max-width: 650;">
                        <children>
                           <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="👤 Hồ Sơ Cá Nhân" />
                           <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                              <children>
                                 <Circle fill="#0066CC" radius="45.0" stroke="#BBDEFB" strokeWidth="3" />
                                 <VBox spacing="8">
                                    <children>
                                       <Label fx:id="lblProfileName" style="-fx-font-weight: bold; -fx-font-size: 18;" text="Nguyen Van A" />
                                       <Label fx:id="lblProfileEmail" style="-fx-text-fill: #6B7280;" text="nguyenvana@email.com" />
                                       <Button fx:id="btnChangeAvatar" onAction="#handleChangeAvatar" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                                        -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;" text="Đổi ảnh đại diện" />
                                    </children>
                                 </VBox>
                              </children>
                           </HBox>
                           <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                              <children>
                                 <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Thông tin cá nhân" />
                                 <Separator />
                                 <HBox spacing="15">
                                    <children>
                                       <VBox spacing="5" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Họ và tên" />
                                             <TextField fx:id="txtFullName" promptText="Nhập họ và tên" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                          </children>
                                       </VBox>
                                       <VBox spacing="5" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Số điện thoại" />
                                             <TextField fx:id="txtPhone" promptText="Nhập số điện thoại" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                          </children>
                                       </VBox>
                                    </children>
                                 </HBox>
                                 <VBox spacing="5">
                                    <children>
                                       <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Email" />
                                       <TextField fx:id="txtEmail" promptText="Nhập email" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </children>
                                 </VBox>
                                 <VBox spacing="5">
                                    <children>
                                       <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Địa chỉ" />
                                       <TextField fx:id="txtAddress" promptText="Nhập địa chỉ" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </children>
                                 </VBox>
                                 <Button fx:id="btnSaveProfile" onAction="#handleSaveProfile" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                                    -fx-font-weight: bold; -fx-background-radius: 8;                                                    -fx-padding: 10 25; -fx-cursor: hand;" text="Lưu thay đổi" />
                              </children>
                           </VBox>
                           <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                              <children>
                                 <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Đổi mật khẩu" />
                                 <Separator />
                                 <VBox spacing="5">
                                    <children>
                                       <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mật khẩu hiện tại" />
                                       <PasswordField fx:id="txtOldPassword" promptText="Nhập mật khẩu hiện tại" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </children>
                                 </VBox>
                                 <HBox spacing="15">
                                    <children>
                                       <VBox spacing="5" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mật khẩu mới" />
                                             <PasswordField fx:id="txtNewPassword" promptText="Nhập mật khẩu mới" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                          </children>
                                       </VBox>
                                       <VBox spacing="5" HBox.hgrow="ALWAYS">
                                          <children>
                                             <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Xác nhận mật khẩu" />
                                             <PasswordField fx:id="txtConfirmPassword" promptText="Nhập lại mật khẩu" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                          </children>
                                       </VBox>
                                    </children>
                                 </HBox>
                                 <Button fx:id="btnChangePassword" onAction="#handleChangePassword" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                                    -fx-background-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;" text="Đổi mật khẩu" />
                              </children>
                           </VBox>
                        </children>
                     </VBox>
                  </content>
               </ScrollPane>
            </content>
         </Tab>
         <Tab fx:id="tabSettings" text="">
            <content>
               <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                  <content>
                     <VBox spacing="20" style="-fx-padding: 25; -fx-max-width: 600;">
                        <children>
                           <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="⚙ Cài Đặt" />
                           <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                              <children>
                                 <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Thông báo" />
                                 <Separator />
                                 <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                       <Label text="Thông báo đấu giá" HBox.hgrow="ALWAYS" />
                                       <Button fx:id="toggleAuctionNotif" onAction="#handleToggleNotification" style="-fx-background-color: #16A34A; -fx-text-fill: white;                                                        -fx-background-radius: 12; -fx-padding: 4 12; -fx-cursor: hand;" text="Bật" />
                                    </children>
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                       <Label text="Thông báo đơn hàng" HBox.hgrow="ALWAYS" />
                                       <Button fx:id="toggleOrderNotif" onAction="#handleToggleNotification" style="-fx-background-color: #16A34A; -fx-text-fill: white;                                                        -fx-background-radius: 12; -fx-padding: 4 12; -fx-cursor: hand;" text="Bật" />
                                    </children>
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                       <Label text="Email thông báo" HBox.hgrow="ALWAYS" />
                                       <Button fx:id="toggleEmailNotif" onAction="#handleToggleNotification" style="-fx-background-color: #9CA3AF; -fx-text-fill: white;                                                        -fx-background-radius: 12; -fx-padding: 4 12; -fx-cursor: hand;" text="Tắt" />
                                    </children>
                                 </HBox>
                              </children>
                           </VBox>
                           <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                              <children>
                                 <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Ngôn ngữ &amp; Hiển thị" />
                                 <Separator />
                                 <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                       <Label text="Ngôn ngữ" HBox.hgrow="ALWAYS" />
                                       <ComboBox fx:id="cmbLanguage" prefWidth="160" style="-fx-background-radius: 8;" />
                                    </children>
                                 </HBox>
                                 <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                       <Label text="Đơn vị tiền tệ" HBox.hgrow="ALWAYS" />
                                       <ComboBox fx:id="cmbCurrency" prefWidth="160" style="-fx-background-radius: 8;" />
                                    </children>
                                 </HBox>
                              </children>
                           </VBox>
                           <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                              <children>
                                 <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Bảo mật" />
                                 <Separator />
                                 <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                       <Label text="Xác thực 2 bước (2FA)" HBox.hgrow="ALWAYS" />
                                       <Button fx:id="toggle2FA" onAction="#handleToggleNotification" style="-fx-background-color: #9CA3AF; -fx-text-fill: white;                                                        -fx-background-radius: 12; -fx-padding: 4 12; -fx-cursor: hand;" text="Tắt" />
                                    </children>
                                 </HBox>
                                 <Button fx:id="btnDeleteAccount" maxWidth="Infinity" onAction="#handleDeleteAccount" style="-fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C;                                                    -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;" text="Xóa tài khoản" />
                              </children>
                           </VBox>
                        </children>
                     </VBox>
                  </content>
               </ScrollPane>
            </content>
         </Tab>

        </TabPane>
    </center>

</BorderPane>
