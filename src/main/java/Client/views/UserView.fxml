<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F4F7F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controller.UserController">

    <!-- ═══════════════════ TOP NAVBAR ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: white;                      -fx-border-color: #E0E0E0;                      -fx-border-width: 0 0 1 0;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <children>
                <!-- Logo -->
                <Label style="-fx-font-weight: bold; -fx-font-size: 22;" text="🔨 AUCTION" textFill="#0066CC">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>

                <!-- Search bar -->
                <HBox alignment="CENTER" maxWidth="460.0" spacing="0" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20; -fx-padding: 0 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 14; -fx-text-fill: #9CA3AF;" text="🔍" />
                    <TextField fx:id="txtSearch" onAction="#handleSearch" promptText="Tìm kiếm sản phẩm, phiên đấu giá..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 8 8;" HBox.hgrow="ALWAYS" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Cart button -->
                <StackPane>
                    <Button fx:id="btnCartTop" onAction="#handleCart" prefHeight="40" prefWidth="40" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20;                                    -fx-cursor: hand; -fx-font-size: 16;" text="🛒" />
                    <Label fx:id="lblCartCount" style="-fx-background-color: #D32F2F; -fx-text-fill: white;                                   -fx-font-size: 9; -fx-font-weight: bold;                                   -fx-background-radius: 8; -fx-padding: 1 4;" text="0" translateX="4" translateY="-4" StackPane.alignment="TOP_RIGHT" />
                </StackPane>

                <!-- Notification button -->
                <StackPane>
                    <Button fx:id="btnNotifTop" onAction="#handleNotification" prefHeight="40" prefWidth="40" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20;                                    -fx-cursor: hand; -fx-font-size: 16;" text="🔔" />
                    <Label fx:id="lblNotifCount" style="-fx-background-color: #f97316; -fx-text-fill: white;                                   -fx-font-size: 9; -fx-font-weight: bold;                                   -fx-background-radius: 8; -fx-padding: 1 4;" text="3" translateX="4" translateY="-4" StackPane.alignment="TOP_RIGHT" />
                </StackPane>

                <!-- Avatar + Username -->
                <HBox alignment="CENTER" spacing="8" style="-fx-cursor: hand;">
                    <Circle fx:id="avatarCircle" fill="#0066CC" radius="18.0" stroke="#BBDEFB" strokeWidth="2" />
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label fx:id="lblUsername" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Nguyen Van A" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #9CA3AF;" text="Member" />
                    </VBox>
                </HBox>
            </children>
        </HBox>
    </top>

    <!-- ═══════════════════ LEFT SIDEBAR ═══════════════════ -->
    <left>
        <VBox prefWidth="200.0" spacing="4.0" style="-fx-background-color: #1a3a5a;">
            <padding><Insets bottom="20" left="10" right="10" top="20" /></padding>
            <children>

                <!-- User info block -->
                <VBox alignment="CENTER" spacing="6" style="-fx-padding: 10 0 16 0;">
                    <Circle fill="#0066CC" radius="32.0" stroke="#4A90D9" strokeWidth="2.5" />
                    <Label fx:id="lblSidebarName" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Nguyen Van A" textFill="WHITE" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #4CAF50;" text="● Online" />
                </VBox>

                <Separator opacity="0.2" />

                <!-- Nav buttons -->
                <Button fx:id="btnDashBoard" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDashBoard" style="-fx-background-color: #0066CC; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🏠  Dashboard" textFill="WHITE">
                    <VBox.margin><Insets top="8" /></VBox.margin>
                </Button>

                <Button fx:id="btnShop" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleShop" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🏪  Shop" textFill="#CBD5E1" />

                <Button fx:id="btnAuction" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAuction" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🔨  Auction" textFill="#CBD5E1" />

                <Button fx:id="btnCart" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCart" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🛒  Cart" textFill="#CBD5E1" />

                <Button fx:id="btnOrderHistory" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleOrderHistory" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="📦  Order History" textFill="#CBD5E1" />


                <Button fx:id="btnNotification" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleNotification" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🔔  Notification" textFill="#CBD5E1" />

                <Button fx:id="btnProfile" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleProfile" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="👤  Profile" textFill="#CBD5E1" />

                <Button fx:id="btnSettings" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSettings" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="⚙  Settings" textFill="#CBD5E1" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.2" />

                <Button fx:id="btnSignOut" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignOut" style="-fx-background-color: #C0392B; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-padding: 10 15; -fx-cursor: hand;" text="🚪  Sign Out" textFill="WHITE">
                    <VBox.margin><Insets top="8" /></VBox.margin>
                </Button>

            </children>
        </VBox>
    </left>

    <!-- ═══════════════════ CENTER CONTENT (TabPane) ═══════════════════ -->
    <center>
        <TabPane fx:id="mainTabPane" style="-fx-background-color: transparent; -fx-tab-min-width: 0; -fx-tab-max-width: 0;" tabClosingPolicy="UNAVAILABLE">

            <!-- ───── TAB 1: DASHBOARD / AUCTION FLOOR ───── -->
            <Tab fx:id="tabDashboard" text="">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox spacing="25.0" style="-fx-padding: 25;">
                            <children>

                                <!-- Summary cards -->
                                <HBox spacing="15">
                                    <children>

                                        <!-- Card: Active bids -->
                                        <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                                      -fx-padding: 16;">
                                            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đang đấu giá" />
                                            <Label fx:id="lblActiveBids" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #0066CC;" text="2 phiên" />
                                        </VBox>
                                        <!-- Card: Won auctions -->
                                        <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                                      -fx-padding: 16;">
                                            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đã thắng" />
                                            <Label fx:id="lblWonAuctions" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #f97316;" text="5 phiên" />
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Auction Floor -->
                                <VBox spacing="12">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🔨 Sàn Đấu Giá" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <ComboBox fx:id="cmbFilter" prefWidth="140" promptText="Lọc theo..." style="-fx-background-radius: 8;" />
                                        </HBox>

                                        <FlowPane fx:id="auctionFlowPane" hgap="18.0" vgap="18.0">
                                            <children>
                                                <!-- Sample auction card (repeated dynamically) -->
                                                <VBox prefWidth="210.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;                                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 10, 0, 0, 3);                                                              -fx-padding: 12;">
                                                    <Region prefHeight="130.0" style="-fx-background-color: #EFF6FF; -fx-background-radius: 8;" />
                                                    <Label fx:id="ProductNameLabel" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Tên sản phẩm" wrapText="true" />
                                                    <VBox spacing="4.0">
                                                        <Label fx:id="StartPriceLabel" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="Giá khởi điểm: 1,000,000 ₫" />
                                                        <Label fx:id="CurrentPriceLabel" style="-fx-font-weight: bold; -fx-font-size: 14;" text="Giá hiện tại: 1,500,000 ₫" textFill="#D32F2F" />
                                                        <HBox alignment="CENTER_LEFT" spacing="4">
                                                            <Label style="-fx-font-size: 11;" text="🕒" />
                                                            <Label fx:id="RemainingTimeLabel" style="-fx-font-size: 11; -fx-text-fill: #0066CC;" text="Còn: 02:34:15" />
                                                        </HBox>
                                                    </VBox>
                                                    <Button maxWidth="Infinity" onAction="#handleAuction" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                                                    -fx-font-weight: bold; -fx-background-radius: 8;                                                                    -fx-cursor: hand; -fx-padding: 8;" text="Đặt giá ngay" />
                                                </VBox>
                                            </children>
                                        </FlowPane>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

            <!-- ───── TAB 2: SHOP ───── -->
            <Tab fx:id="tabShop" text="">
                <VBox spacing="15" style="-fx-padding: 25;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🏪 Shop" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="txtShopSearch" prefWidth="300" promptText="Tìm sản phẩm..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                            <ComboBox fx:id="cmbCategory" prefWidth="150" promptText="Danh mục" style="-fx-background-radius: 8;" />
                            <ComboBox fx:id="cmbSort" prefWidth="150" promptText="Sắp xếp" style="-fx-background-radius: 8;" />
                        </HBox>
                        <ScrollPane fitToWidth="true" style="-fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="shopFlowPane" hgap="18" style="-fx-padding: 5;" vgap="18">
                                    <!-- Product cards loaded dynamically -->
                                </FlowPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </Tab>

            <!-- ───── TAB 3: CART ───── -->
            <Tab fx:id="tabCart" text="">
                <VBox spacing="15" style="-fx-padding: 25;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🛒 Giỏ Hàng" />
                        <HBox spacing="15" VBox.vgrow="ALWAYS">
                            <!-- Cart items table -->
                            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                <TableView fx:id="tableCart" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colCartImage" prefWidth="60" text="" />
                                        <TableColumn fx:id="colCartName" prefWidth="200" text="Sản phẩm" />
                                        <TableColumn fx:id="colCartPrice" prefWidth="120" text="Đơn giá" />
                                        <TableColumn fx:id="colCartQty" prefWidth="100" text="Số lượng" />
                                        <TableColumn fx:id="colCartTotal" prefWidth="120" text="Thành tiền" />
                                        <TableColumn fx:id="colCartAction" prefWidth="80" text="Xóa" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                            <!-- Order summary -->
                            <VBox prefWidth="240" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Tóm tắt đơn hàng" />
                                <Separator />
                                <HBox>
                                    <Label text="Tạm tính" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblSubtotal" style="-fx-font-weight: bold;" text="0 ₫" />
                                </HBox>
                                <HBox>
                                    <Label text="Phí vận chuyển" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblShipping" style="-fx-text-fill: #9CA3AF;" text="30,000 ₫" />
                                </HBox>
                                <Separator />
                                <HBox>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Tổng cộng" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblCartTotal" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #D32F2F;" text="0 ₫" />
                                </HBox>
                                <Button fx:id="btnCheckout" maxWidth="Infinity" onAction="#handleCheckout" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                                -fx-font-weight: bold; -fx-background-radius: 8;                                                -fx-padding: 12; -fx-cursor: hand;" text="Thanh toán" />
                                <Button fx:id="btnContinueShopping" maxWidth="Infinity" onAction="#handleShop" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                                -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;" text="Tiếp tục mua sắm" />
                            </VBox>
                        </HBox>
                    </children>
                </VBox>
            </Tab>

            <!-- ───── TAB 4: ORDER HISTORY ───── -->
            <Tab fx:id="tabOrderHistory" text="">
                <VBox spacing="15" style="-fx-padding: 25;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="📦 Lịch Sử Đơn Hàng" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <ComboBox fx:id="cmbOrderStatus" prefWidth="160" promptText="Trạng thái" style="-fx-background-radius: 8;" />
                            <TextField fx:id="txtOrderSearch" prefWidth="220" promptText="Tìm theo mã đơn..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                        </HBox>
                        <TableView fx:id="tableOrderHistory" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colOrderId" prefWidth="120" text="Mã đơn" />
                                <TableColumn fx:id="colOrderDate" prefWidth="130" text="Ngày đặt" />
                                <TableColumn fx:id="colOrderItems" prefWidth="200" text="Sản phẩm" />
                                <TableColumn fx:id="colOrderTotal" prefWidth="130" text="Tổng tiền" />
                                <TableColumn fx:id="colOrderStatus" prefWidth="120" text="Trạng thái" />
                                <TableColumn fx:id="colOrderDetail" prefWidth="100" text="Chi tiết" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </Tab>


            <!-- ───── TAB 5: AUCTION ───── -->
            <Tab fx:id="tabAuction" text="">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox spacing="25" style="-fx-padding: 25;">

                            <!-- Header -->
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🔨 Sàn Đấu Giá" />
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER" spacing="0" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20; -fx-padding: 0 10;">
                                    <Label style="-fx-font-size: 13; -fx-text-fill: #9CA3AF;" text="🔍" />
                                    <TextField fx:id="txtAuctionSearch" onAction="#handleAuctionSearch" prefWidth="200" promptText="Tìm phiên đấu giá..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 8;" />
                                </HBox>
                                <ComboBox fx:id="cmbAuctionFilter" prefWidth="150" promptText="Trạng thái" style="-fx-background-radius: 8;" />
                                <Button onAction="#handleRefreshAuctions" style="-fx-background-color: #F0F4F8; -fx-text-fill: #374151;                                                -fx-background-radius: 8; -fx-padding: 8 14; -fx-cursor: hand;" text="🔄 Làm mới" />
                            </HBox>

                            <!-- Stats cards -->
                            <HBox spacing="15">
                                <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                              -fx-padding: 16;">
                                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đang diễn ra" />
                                    <Label fx:id="lblActiveCount" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #16A34A;" text="0" />
                                </VBox>
                                <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                              -fx-padding: 16;">
                                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Sắp bắt đầu" />
                                    <Label fx:id="lblUpcomingCount" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #f97316;" text="0" />
                                </VBox>
                                <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                              -fx-padding: 16;">
                                    <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Tôi đang tham gia" />
                                    <Label fx:id="lblMyBidsCount" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #0066CC;" text="0" />
                                </VBox>
                            </HBox>

                            <!-- Auction table -->
                            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Danh sách phiên đấu giá" />
                                <TableView fx:id="tableAuctions" prefHeight="240">
                                    <columns>
                                        <TableColumn fx:id="colAucId" prefWidth="60" text="ID" />
                                        <TableColumn fx:id="colAucItem" prefWidth="220" text="Sản phẩm" />
                                        <TableColumn fx:id="colAucStartPrice" prefWidth="130" text="Giá khởi điểm" />
                                        <TableColumn fx:id="colAucCurrentPrice" prefWidth="130" text="Giá hiện tại" />
                                        <TableColumn fx:id="colAucEndTime" prefWidth="160" text="Kết thúc lúc" />
                                        <TableColumn fx:id="colAucStatus" prefWidth="110" text="Trạng thái" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #9CA3AF;" text="Không có phiên đấu giá nào" />
                                    </placeholder>
                                </TableView>
                            </VBox>

                            <!-- Đặt giá panel -->
                            <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="💰 Đặt Giá" />
                                <Separator />
                                <HBox alignment="CENTER_LEFT" spacing="20">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Phiên đang chọn:" />
                                        <Label fx:id="lblSelectedAuction" style="-fx-font-weight: bold; -fx-font-size: 13;" text="— Chưa chọn phiên nào —" />
                                    </VBox>
                                    <VBox spacing="4">
                                        <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Giá cao nhất hiện tại:" />
                                        <Label fx:id="lblCurrentHighest" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #D32F2F;" text="—" />
                                    </VBox>
                                    <VBox spacing="4">
                                        <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Giá của bạn (₫):" />
                                        <TextField fx:id="txtBidAmount" prefHeight="38" prefWidth="180" promptText="Nhập giá..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                                    </VBox>
                                    <VBox spacing="4">
                                        <Label text=" " />
                                        <Button fx:id="btnPlaceBid" onAction="#handlePlaceBid" prefHeight="38" prefWidth="130" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                                        -fx-font-weight: bold; -fx-background-radius: 8;                                                        -fx-cursor: hand;" text="🔨 Đặt Giá" />
                                    </VBox>
                                </HBox>

                                <!-- Bid history -->
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Lịch sử đặt giá của phiên này:" />
                                <TableView fx:id="tableBidHistory" prefHeight="150">
                                    <columns>
                                        <TableColumn fx:id="colBidUser" prefWidth="200" text="Người đặt" />
                                        <TableColumn fx:id="colBidAmount" prefWidth="160" text="Giá đặt (₫)" />
                                        <TableColumn fx:id="colBidTime" prefWidth="200" text="Thời gian" />
                                        <TableColumn fx:id="colBidStatus" prefWidth="150" text="Trạng thái" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <placeholder>
                                        <Label style="-fx-text-fill: #9CA3AF;" text="Chọn một phiên để xem lịch sử đặt giá" />
                                    </placeholder>
                                </TableView>
                            </VBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

            <!-- ───── TAB 6: NOTIFICATION ───── -->
            <Tab fx:id="tabNotification" text="">
                <VBox spacing="15" style="-fx-padding: 25;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🔔 Thông Báo" />
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>

                        <HBox spacing="8">
                            <Button fx:id="btnNotifAll" onAction="#filterNotifAll" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                            -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Tất cả" />
                            <Button fx:id="btnNotifUnread" onAction="#filterNotifUnread" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                            -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Chưa đọc" />
                            <Button fx:id="btnNotifAuction" onAction="#filterNotifAuction" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                            -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Đấu giá" />
                            <Button fx:id="btnNotifOrder" onAction="#filterNotifOrder" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                            -fx-background-radius: 20; -fx-padding: 5 15; -fx-cursor: hand;" text="Đơn hàng" />
                        </HBox>

                        <ScrollPane fitToWidth="true" style="-fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="notificationList" spacing="8" style="-fx-padding: 5;">
                                    <!-- Sample notification item -->
                                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-padding: 12;">
                                        <Label style="-fx-font-size: 20;" text="🔨" />
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Bạn đang dẫn đầu phiên đấu giá!" />
                                            <Label style="-fx-font-size: 12; -fx-text-fill: #4B5563;" text="Laptop Dell XPS 15 - Giá hiện tại: 12,000,000 ₫" />
                                        </VBox>
                                        <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="5 phút trước" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10;                                                  -fx-border-color: #E5E7EB; -fx-border-radius: 10; -fx-padding: 12;">
                                        <Label style="-fx-font-size: 20;" text="📦" />
                                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-font-size: 13;" text="Đơn hàng #ORD-0042 đã được giao" />
                                            <Label style="-fx-font-size: 12; -fx-text-fill: #4B5563;" text="Vui lòng xác nhận đã nhận hàng" />
                                        </VBox>
                                        <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="1 giờ trước" />
                                    </HBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </Tab>

            <!-- ───── TAB 7: PROFILE ───── -->
            <Tab fx:id="tabProfile" text="">
                <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                    <content>
                        <VBox spacing="20" style="-fx-padding: 25; -fx-max-width: 650;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="👤 Hồ Sơ Cá Nhân" />

                                <!-- Avatar section -->
                                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                                    <Circle fill="#0066CC" radius="45.0" stroke="#BBDEFB" strokeWidth="3" />
                                    <VBox spacing="8">
                                        <Label fx:id="lblProfileName" style="-fx-font-weight: bold; -fx-font-size: 18;" text="Nguyen Van A" />
                                        <Label fx:id="lblProfileEmail" style="-fx-text-fill: #6B7280;" text="nguyenvana@email.com" />
                                        <Button fx:id="btnChangeAvatar" onAction="#handleChangeAvatar" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                                        -fx-background-radius: 8; -fx-padding: 6 14; -fx-cursor: hand;" text="Đổi ảnh đại diện" />
                                    </VBox>
                                </HBox>

                                <!-- Personal info form -->
                                <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Thông tin cá nhân" />
                                    <Separator />

                                    <HBox spacing="15">
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Họ và tên" />
                                            <TextField fx:id="txtFullName" promptText="Nhập họ và tên" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Số điện thoại" />
                                            <TextField fx:id="txtPhone" promptText="Nhập số điện thoại" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Email" />
                                        <TextField fx:id="txtEmail" promptText="Nhập email" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </VBox>

                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Địa chỉ" />
                                        <TextField fx:id="txtAddress" promptText="Nhập địa chỉ" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </VBox>

                                    <Button fx:id="btnSaveProfile" onAction="#handleSaveProfile" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                                    -fx-font-weight: bold; -fx-background-radius: 8;                                                    -fx-padding: 10 25; -fx-cursor: hand;" text="Lưu thay đổi" />
                                </VBox>

                                <!-- Change password -->
                                <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Đổi mật khẩu" />
                                    <Separator />
                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mật khẩu hiện tại" />
                                        <PasswordField fx:id="txtOldPassword" promptText="Nhập mật khẩu hiện tại" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </VBox>
                                    <HBox spacing="15">
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mật khẩu mới" />
                                            <PasswordField fx:id="txtNewPassword" promptText="Nhập mật khẩu mới" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Xác nhận mật khẩu" />
                                            <PasswordField fx:id="txtConfirmPassword" promptText="Nhập lại mật khẩu" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                    </HBox>
                                    <Button fx:id="btnChangePassword" onAction="#handleChangePassword" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                                    -fx-background-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;" text="Đổi mật khẩu" />
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

            <!-- ───── TAB 8: SETTINGS ───── -->
            <Tab fx:id="tabSettings" text="">
                <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                    <content>
                        <VBox spacing="20" style="-fx-padding: 25; -fx-max-width: 600;">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="⚙ Cài Đặt" />

                                <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Thông báo" />
                                    <Separator />
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Thông báo đấu giá" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="toggleAuctionNotif" style="-fx-background-color: #16A34A; -fx-text-fill: white;                                                        -fx-background-radius: 12; -fx-padding: 4 12; -fx-cursor: hand;" text="Bật" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Thông báo đơn hàng" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="toggleOrderNotif" style="-fx-background-color: #16A34A; -fx-text-fill: white;                                                        -fx-background-radius: 12; -fx-padding: 4 12; -fx-cursor: hand;" text="Bật" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Email thông báo" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="toggleEmailNotif" style="-fx-background-color: #9CA3AF; -fx-text-fill: white;                                                        -fx-background-radius: 12; -fx-padding: 4 12; -fx-cursor: hand;" text="Tắt" />
                                    </HBox>
                                </VBox>

                                <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Ngôn ngữ &amp; Hiển thị" />
                                    <Separator />
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Ngôn ngữ" HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="cmbLanguage" prefWidth="160" style="-fx-background-radius: 8;" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Đơn vị tiền tệ" HBox.hgrow="ALWAYS" />
                                        <ComboBox fx:id="cmbCurrency" prefWidth="160" style="-fx-background-radius: 8;" />
                                    </HBox>
                                </VBox>

                                <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Bảo mật" />
                                    <Separator />
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label text="Xác thực 2 bước (2FA)" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="toggle2FA" style="-fx-background-color: #9CA3AF; -fx-text-fill: white;                                                        -fx-background-radius: 12; -fx-padding: 4 12; -fx-cursor: hand;" text="Tắt" />
                                    </HBox>
                                    <Button fx:id="btnDeleteAccount" maxWidth="Infinity" onAction="#handleDeleteAccount" style="-fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C;                                                    -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;" text="Xóa tài khoản" />
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
