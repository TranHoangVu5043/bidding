                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mật khẩu hiện tại" textFill="#262323" />
                                        <PasswordField fx:id="txtOldPassword" promptText="Nhập mật khẩu hiện tại" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </VBox>
                                    <HBox spacing="15">
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mật khẩu mới" />
                                            <PasswordField fx:id="txtNewPassword" promptText="Nhập mật khẩu mới" style="-fx-background-radius: 8; -fx-padding: 9;" />
