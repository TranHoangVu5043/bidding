                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Số điện thoại" />
                                            <TextField fx:id="txtPhone" promptText="Nhập số điện thoại" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                    </HBox>

                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Email" />
                                        <TextField fx:id="txtEmail" promptText="Nhập email" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </VBox>

                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Địa chỉ" />
                                        <TextField fx:id="txtAddress" promptText="Nhập địa chỉ" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </VBox>

                                    <Button fx:id="btnSaveProfile" onAction="#handleSaveProfile" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                                    -fx-font-weight: bold; -fx-background-radius: 8;                                                    -fx-padding: 10 25; -fx-cursor: hand;" text="Lưu thay đổi" />
