<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F4F7F9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controller.UserController">

    <!-- ═══════════════════ TOP NAVBAR ═══════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-background-color: white;                      -fx-border-color: #E0E0E0;                      -fx-border-width: 0 0 1 0;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <padding><Insets bottom="10" left="20" right="20" top="10" /></padding>
            <children>
                <!-- Logo -->
                <Label style="-fx-font-weight: bold; -fx-font-size: 22;" text="🔨 AUCTION" textFill="#0066CC">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>

                <!-- Search bar -->
                <HBox alignment="CENTER" maxWidth="460.0" spacing="0" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20; -fx-padding: 0 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 14; -fx-text-fill: #9CA3AF;" text="🔍" />
                    <TextField fx:id="txtSearch" onAction="#handleSearch" promptText="Tìm kiếm sản phẩm, phiên đấu giá..." style="-fx-background-color: transparent; -fx-border-width: 0; -fx-padding: 8 8;" HBox.hgrow="ALWAYS" />
               <padding>
                  <Insets right="30.0" />
               </padding>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                         <!-- Cart button -->
                <StackPane>
                    <Button fx:id="btnCartTop" onAction="#handleCart" prefHeight="40" prefWidth="40" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20;                                    -fx-cursor: hand; -fx-font-size: 16;" text="🛒" />
                    <Label fx:id="lblCartCount" mouseTransparent="true" style="-fx-background-color: #D32F2F; -fx-text-fill: white;                                   -fx-font-size: 9; -fx-font-weight: bold;                                   -fx-background-radius: 8; -fx-padding: 1 4;" text="0" translateX="4" translateY="-4" StackPane.alignment="TOP_RIGHT" />
                </StackPane>

                <!-- Notification button -->
                <StackPane>
               <Button fx:id="btnNotifTop" mnemonicParsing="false" prefHeight="39.0" prefWidth="43.0" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20; -fx-cursor: hand; -fx-background-size: 16;" text="🔔 ">
                  <font>
                     <Font size="16.0" />
                  </font>
                  <contextMenu>
                     <ContextMenu height="300.0" maxWidth="400.0" prefWidth="400.0" style="-fx-translate-y: 15; -fx-translate-x: -200;" width="300.0">
                       <items>
                           <MenuItem mnemonicParsing="false">
                              <graphic>
                                 <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="20.0">
                                    <children>
                                       <Label minWidth="-Infinity" style="-fx-font-size: 13;" text="Đơn hàng #ORD-0042 đã được giao" textFill="#3f2f2f" />
                                       <Label minWidth="-Infinity" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="5 phút trước">
                                          <HBox.margin>
                                             <Insets right="30.0" />
                                          </HBox.margin>
                                       </Label>
                                    </children>
                                    <padding>
                                       <Insets right="40.0" />
                                    </padding>
                                 </HBox>
                              </graphic>
                           </MenuItem>
                       </items>
                     </ContextMenu>
                  </contextMenu>
               </Button>
                    <Label fx:id="lblNotifCount" mouseTransparent="true" style="-fx-background-color: #f97316; -fx-text-fill: white;                                   -fx-font-size: 9; -fx-font-weight: bold;                                   -fx-background-radius: 8; -fx-padding: 1 4;" text="3" translateX="4" translateY="-4" StackPane.alignment="TOP_RIGHT" />
                </StackPane>

                <!-- Avatar + Username -->
                <HBox alignment="CENTER" spacing="8" style="-fx-cursor: hand;">
                    <Circle fx:id="avatarCircle" fill="#0066CC" radius="18.0" stroke="#BBDEFB" strokeWidth="2" />
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label fx:id="lblUsername" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Nguyen Van A" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #9CA3AF;" text="Member" />
                    </VBox>
                </HBox>
            </children>
        </HBox>
    </top>

    <!-- ═══════════════════ LEFT SIDEBAR ═══════════════════ -->
    <left>
        <VBox prefWidth="200.0" spacing="10.0" style="-fx-background-color: #1a3a5a;">
            <padding><Insets bottom="20" left="10" right="10" top="20" /></padding>
            <children>

                <!-- User info block -->
                <VBox alignment="CENTER" spacing="6.0" style="-fx-padding: 10 0 16 0;">
                    <Circle fill="#0066CC" radius="32.0" stroke="#4A90D9" strokeWidth="2.5" />
                    <Label fx:id="lblSidebarName" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Nguyen Van A" textFill="WHITE" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #4CAF50;" text="● Online" />
                </VBox>

                <Separator opacity="0.2" />

                <!-- Nav buttons -->
                <Button fx:id="btnDashBoard" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDashBoard" style="-fx-background-color: #0066CC; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🏠  Dashboard" textFill="WHITE">
                    <VBox.margin><Insets top="8" /></VBox.margin>
                </Button>

                <Button fx:id="btnShop" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleShop" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🏪  Shop" textFill="#CBD5E1" />

                <Button fx:id="btnCart" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCart" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="🛒  Cart" textFill="#CBD5E1" />

                <Button fx:id="btnOrderHistory" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleOrderHistory" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="📦  Order History" textFill="#CBD5E1" />

                <Button fx:id="btnProfile" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleProfile" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="👤  Profile" textFill="#CBD5E1" />

                <Button fx:id="btnSettings" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSettings" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15;" text="⚙  Settings" textFill="#CBD5E1" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.2" />

                <Button fx:id="btnSignOut" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignOut" style="-fx-background-color: #C0392B; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-padding: 10 15; -fx-cursor: hand;" text="🚪  Sign Out" textFill="WHITE">
                    <VBox.margin><Insets top="8" /></VBox.margin>
                </Button>

            </children>
        </VBox>
    </left>

    <!-- ═══════════════════ CENTER CONTENT (TabPane) ═══════════════════ -->
    <center>
        <TabPane fx:id="mainTabPane" style="-fx-background-color: transparent; -fx-tab-min-width: 0; -fx-tab-max-width: 0;" tabClosingPolicy="UNAVAILABLE">

            <!-- ───── TAB 1: DASHBOARD / AUCTION FLOOR ───── -->
            <Tab fx:id="tabDashboard" text="">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
                    <content>
                        <VBox spacing="25.0" style="-fx-padding: 25;">
                            <children>

                                <!-- Summary cards -->
                                <HBox spacing="15">
                                    <children>

                                        <!-- Card: Active bids -->
                                        <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                                      -fx-padding: 16;">
                                            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đang đấu giá" textFill="#1d1c1c" />
                                            <Label fx:id="lblActiveBids" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #0066CC;" text="2 phiên" />
                                        </VBox>
                                        <!-- Card: Won auctions -->
                                        <VBox prefHeight="90" prefWidth="200" spacing="5" style="-fx-background-color: white; -fx-background-radius: 10;                                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 8, 0, 0, 2);                                                      -fx-padding: 16;">
                                            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đã thắng" />
                                            <Label fx:id="lblWonAuctions" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #f97316;" text="5 phiên" />
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Auction Floor -->
                                <VBox spacing="12">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" maxWidth="1000.0" prefWidth="1000.0" spacing="10" VBox.vgrow="ALWAYS">
                                            <Label prefHeight="27.0" prefWidth="149.0" style="-fx-font-weight: bold; -fx-font-size: 18;" text="🔨 Sàn Đấu Giá" textFill="#1f1c1c" />
                                 <Region prefHeight="39.0" prefWidth="499.0" HBox.hgrow="ALWAYS" />
                                            <ComboBox fx:id="cmbFilter" prefWidth="140.0" promptText="Lọc theo..." style="-fx-background-radius: 8;" />
                                 <Button fx:id="btnRefreshAuctions" mnemonicParsing="false" prefHeight="39.0" prefWidth="41.0" style="-fx-background-color: #F0F4F8; -fx-background-radius: 20; -fx-cursor: hand; -fx-background-size: 16;" text="🔄">
                                    <font>
                                       <Font size="13.0" />
                                    </font>
                                    <contextMenu>
                                       <ContextMenu height="300.0" maxWidth="400.0" prefWidth="400.0" style="-fx-translate-y: 15; -fx-translate-x: -200;" width="300.0">
                                          <items>
                                             <MenuItem mnemonicParsing="false">
                                                <graphic>
                                                   <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="20.0">
                                                      <children>
                                                         <Label minWidth="-Infinity" style="-fx-font-size: 13;" text="Đơn hàng #ORD-0042 đã được giao" textFill="#3f2f2f" />
                                                         <Label minWidth="-Infinity" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="5 phút trước">
                                                            <HBox.margin>
                                                               <Insets right="30.0" />
                                                            </HBox.margin>
                                                         </Label>
                                                      </children>
                                                      <padding>
                                                         <Insets right="40.0" />
                                                      </padding>
                                                   </HBox>
                                                </graphic>
                                             </MenuItem>
                                          </items>
                                       </ContextMenu>
                                    </contextMenu>
                                 </Button>
                                        </HBox>

                                        <FlowPane fx:id="auctionFlowPane" hgap="18.0" prefHeight="311.0" prefWidth="849.0" vgap="18.0">
                                            <children>
                                                <!-- Sample auction card (repeated dynamically) -->
                                                <VBox prefHeight="385.0" prefWidth="210.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;                                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 10, 0, 0, 3);                                                              -fx-padding: 12;">
                                                    <Region prefHeight="130.0" style="-fx-background-color: #EFF6FF; -fx-background-radius: 8;" />
                                       <HBox>
                                          <children>
                                             <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Tên sản phẩm :" textFill="#1f1d1d" wrapText="true" />
                                             <Label fx:id="lblProductName" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Túi Sách " textFill="#1f1d1d" wrapText="true" />
                                          </children>
                                       </HBox>
                                                    <VBox spacing="4.0">
                                          <HBox>
                                             <children>
                                                <Label fx:id="lblStartPrice1" prefHeight="16.0" prefWidth="80.0" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="Giá khởi điểm: " textFill="#b1a2a2">
                                                   <font>
                                                      <Font size="18.0" />
                                                   </font>
                                                </Label>
                                                <Label fx:id="lblStartPrice" style="-fx-font-weight: bold; -fx-font-size: 13;" text="1,000,000 đ" textFill="#b1a2a2" wrapText="true" />
                                             </children>
                                          </HBox>
                                          <HBox>
                                             <children>
                                                <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Giá hiện tại: " textFill="#D32F2F" />
                                                <Label fx:id="lblCurrentPrice" style="-fx-font-weight: bold; -fx-font-size: 13;" text="1,500,000 ₫" textFill="#d91010" wrapText="true" />
                                             </children>
                                          </HBox>
                                                        <HBox alignment="CENTER_LEFT" prefHeight="16.0" prefWidth="178.0">
                                                            <Label prefHeight="16.0" prefWidth="49.0" style="-fx-font-size: 11; -fx-text-fill: #0066CC;" text="🕒  Còn : " textFill="#242222">
                                                <HBox.margin>
                                                   <Insets left="20.0" />
                                                </HBox.margin></Label>
                                                            <Label fx:id="lblRemainingTime" prefHeight="16.0" prefWidth="77.0" style="-fx-font-size: 11; -fx-text-fill: #0066CC;" text="02:34:15 " />
                                                        </HBox>
                                                    </VBox>
                                                    <Button maxWidth="Infinity" onAction="#handleAuction" style="-fx-background-color: #004C8C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8;" text="Đặt giá ngay" />
                                       <Button maxWidth="Infinity" onAction="#handleAddCart" prefHeight="33.0" prefWidth="148.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #0066CC; -fx-border-width: 1px; -fx-text-fill: #0066CC; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-cursor: hand; -fx-padding: 8;" text="Theo dõi " textFill="#f6e5e5" />
                                                </VBox>
                                            </children>
                                        </FlowPane>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </content>
                </ScrollPane>
            </Tab>

            <!-- ───── TAB 2: SHOP ───── -->
            <Tab fx:id="tabShop" text="">
                <VBox spacing="10.0" style="-fx-padding: 25;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🏪 Shop" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="txtShopSearch" prefWidth="300" promptText="Tìm sản phẩm..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                            <ComboBox fx:id="cmbCategory" prefWidth="150" promptText="Danh mục" style="-fx-background-radius: 8;" />
                            <ComboBox fx:id="cmbSort" prefWidth="150" promptText="Sắp xếp" style="-fx-background-radius: 8;" />
                        </HBox>
                        <ScrollPane fitToWidth="true" style="-fx-background: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="shopFlowPane" hgap="18" style="-fx-padding: 5;" vgap="18">
                           <children>
                              <VBox prefHeight="385.0" prefWidth="210.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12;                                                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 10, 0, 0, 3);                                                              -fx-padding: 12;">
                                 <children>
                                    <Region prefHeight="130.0" style="-fx-background-color: #EFF6FF; -fx-background-radius: 8;" />
                                    <HBox>
                                       <children>
                                          <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Tên sản phẩm :" textFill="#1f1d1d" wrapText="true" />
                                          <Label fx:id="lblProductName1" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Túi Sách " textFill="#1f1d1d" wrapText="true" />
                                       </children>
                                    </HBox>
                                    <VBox spacing="4.0">
                                       <children>
                                          <HBox>
                                             <children>
                                                <Label fx:id="lblStartPrice12" prefHeight="16.0" prefWidth="80.0" style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="Giá khởi điểm: " textFill="#b1a2a2">
                                                   <font>
                                                      <Font size="18.0" />
                                                   </font>
                                                </Label>
                                                <Label fx:id="lblStartPrice1" style="-fx-font-weight: bold; -fx-font-size: 13;" text="1,000,000 đ" textFill="#b1a2a2" wrapText="true" />
                                             </children>
                                          </HBox>
                                          <HBox>
                                             <children>
                                                <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Giá hiện tại: " textFill="#D32F2F" />
                                                <Label fx:id="lblCurrentPrice1" style="-fx-font-weight: bold; -fx-font-size: 13;" text="1,500,000 ₫" textFill="#d91010" wrapText="true" />
                                             </children>
                                          </HBox>
                                          <HBox alignment="CENTER_LEFT" prefHeight="16.0" prefWidth="178.0">
                                             <children>
                                                <Label prefHeight="16.0" prefWidth="49.0" style="-fx-font-size: 11; -fx-text-fill: #0066CC;" text="🕒  Còn : " textFill="#242222">
                                                   <HBox.margin>
                                                      <Insets left="20.0" />
                                                   </HBox.margin>
                                                </Label>
                                                <Label fx:id="lblRemainingTime1" prefHeight="16.0" prefWidth="77.0" style="-fx-font-size: 11; -fx-text-fill: #0066CC;" text="02:34:15 " />
                                             </children>
                                          </HBox>
                                       </children>
                                    </VBox>
                                    <Button maxWidth="Infinity" onAction="#handleAuction" style="-fx-background-color: #004C8C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 8;" text="Đặt giá ngay" />
                                    <Button maxWidth="Infinity" onAction="#handleAddCart" prefHeight="33.0" prefWidth="148.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #0066CC; -fx-border-width: 1px; -fx-text-fill: #0066CC; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-border-radius: 8px; -fx-cursor: hand; -fx-padding: 8;" text="Theo dõi " textFill="#f6e5e5" />
                                 </children>
                              </VBox>
                           </children></FlowPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </Tab>

            <!-- ───── TAB 3: CART ───── -->
            <Tab fx:id="tabCart" text="">
                <VBox spacing="15" style="-fx-padding: 25;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="🛒 Giỏ Hàng" />
                        <HBox spacing="15" VBox.vgrow="ALWAYS">
                            <!-- Cart items table -->
                            <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15;" HBox.hgrow="ALWAYS">
                                <TableView fx:id="tableCart" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colCartImage" prefWidth="60" />
                                        <TableColumn fx:id="colCartName" prefWidth="200" text="Sản phẩm" />
                                        <TableColumn fx:id="colCartPrice" prefWidth="120" text="Đơn giá" />
                                        <TableColumn fx:id="colCartQty" prefWidth="100" text="Số lượng" />
                                        <TableColumn fx:id="colCartTotal" prefWidth="120" text="Thành tiền" />
                                        <TableColumn fx:id="colCartAction" prefWidth="80" text="Xóa" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </VBox>

                            <!-- Order summary -->
                            <VBox prefWidth="240" spacing="12" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Tóm tắt đơn hàng" />
                                <Separator />
                                <HBox>
                                    <Label text="Tạm tính" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblSubtotal" style="-fx-font-weight: bold;" text="0 ₫" />
                                </HBox>
                                <HBox>
                                    <Label text="Phí vận chuyển" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblShipping" style="-fx-text-fill: #9CA3AF;" text="30,000 ₫" />
                                </HBox>
                                <Separator />
                                <HBox>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Tổng cộng" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblCartTotal" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #D32F2F;" text="0 ₫" />
                                </HBox>
                                <Button fx:id="btnCheckout" maxWidth="Infinity" onAction="#handleCheckout" style="-fx-background-color: #0066CC; -fx-text-fill: white;                                                -fx-font-weight: bold; -fx-background-radius: 8;                                                -fx-padding: 12; -fx-cursor: hand;" text="Thanh toán" />
                                <Button fx:id="btnContinueShopping" maxWidth="Infinity" onAction="#handleShop" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                                -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;" text="Tiếp tục mua sắm" />
                            </VBox>
                        </HBox>
                    </children>
                </VBox>
            </Tab>

            <!-- ───── TAB 4: ORDER HISTORY ───── -->
            <Tab fx:id="tabOrderHistory" text="">
                <VBox spacing="15" style="-fx-padding: 25;">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="📦 Lịch Sử Đơn Hàng" />
