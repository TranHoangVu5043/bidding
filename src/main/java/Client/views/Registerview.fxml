<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
  Root changed from AnchorPane (absolute layout) to StackPane so the card
  stays centred when the window is resized.
-->
<StackPane style="-fx-background-color: #1a337e;"
    xmlns="http://javafx.com/javafx/22"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="Client.controller.auth.RegisterController">
    <children>

        <!-- ── Main card ── centred by StackPane automatically ── -->
        <VBox alignment="CENTER" maxWidth="470.0" spacing="0">
            <padding><Insets top="24.0" bottom="24.0" /></padding>
            <children>

                <!-- Title -->
                <Label text="REGISTER" textFill="WHITE">
                    <font><Font name="System Bold" size="36.0" /></font>
                    <VBox.margin><Insets bottom="20.0" /></VBox.margin>
                </Label>

                <!-- White/light-blue card -->
                <VBox alignment="TOP_CENTER" spacing="15.0"
                      style="-fx-background-color: #e0f2fe; -fx-background-radius: 30;">
                    <padding><Insets top="20.0" bottom="40.0" left="30.0" right="30.0" /></padding>
                    <children>

                        <TabPane prefHeight="480.0" maxWidth="Infinity"
                                 style="-fx-tab-min-width: 190; -fx-tab-max-width: 190;
                                        -fx-tab-min-height: 40; -fx-background-color: transparent;"
                                 tabClosingPolicy="UNAVAILABLE">
                            <tabs>

                                <!-- ═══ USER TAB ═══ -->
                                <Tab fx:id="tabUser" text="User"
                                     style="-fx-background-color: #001f5c;
                                            -fx-background-radius: 10 0 0 10;
                                            -fx-text-base-color: white; -fx-font-weight: bold;">
                                    <content>
                                        <VBox spacing="20.0" style="-fx-padding: 20 0 0 0;">
                                            <children>
                                                <Label text="Thông tin cá nhân"
                                                       style="-fx-font-weight: bold; -fx-text-fill: #64748b;" />
                                                <TextField fx:id="txtFullName"
                                                           prefHeight="40" prefWidth="315.0"
                                                           promptText="Họ Và Tên"
                                                           style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                                  -fx-border-color: #333; -fx-background-color: white;
                                                                  -fx-padding: 10 10 10 15;">
                                                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                                                </TextField>
                                                <TextField fx:id="txtEmail"
                                                           prefHeight="40" prefWidth="315.0"
                                                           promptText="Email"
                                                           style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                                  -fx-border-color: #333; -fx-background-color: white;
                                                                  -fx-padding: 10 10 10 15;">
                                                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                                                </TextField>
                                                <PasswordField fx:id="txtPassword"
                                                               prefHeight="40" prefWidth="315.0"
                                                               promptText="Mật Khẩu"
                                                               style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                                      -fx-border-color: #333; -fx-background-color: white;
                                                                      -fx-padding: 10 10 10 15;">
                                                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                                                </PasswordField>
                                                <Button fx:id="btnRegister" onAction="#handleRegister"
                                                        prefHeight="41.0" prefWidth="180.0"
                                                        text="Đăng Ký"
                                                        style="-fx-background-color: #0ea5e9; -fx-text-fill: white;
                                                               -fx-font-weight: bold; -fx-background-radius: 20;
                                                               -fx-padding: 12; -fx-cursor: hand;">
                                                    <VBox.margin><Insets left="30.0" top="10.0" /></VBox.margin>
                                                </Button>
                                                <Hyperlink onAction="#handleNavigateToLogin"
                                                           text="Đã Có Tài Khoản? Đăng Nhập"
                                                           style="-fx-text-fill: #1a337e;">
                                                    <VBox.margin><Insets left="30.0" /></VBox.margin>
                                                </Hyperlink>
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                                <!-- ═══ SELLER TAB ═══ -->
                                <Tab fx:id="tabSeller" text="Seller"
                                     style="-fx-background-color: #5c6bc0;
                                            -fx-background-radius: 0 10 10 0;
                                            -fx-text-base-color: white; -fx-font-weight: bold;">
                                    <content>
                                        <VBox spacing="20.0" style="-fx-padding: 20 0 0 0;">
                                            <children>
                                                <Label text="Hồ Sơ Định Danh"
                                                       style="-fx-font-weight: bold; -fx-text-fill: #64748b;" />
                                                <TextField fx:id="txtSellerFullName"
                                                           prefHeight="40" prefWidth="315.0"
                                                           promptText="Tên Cá Nhân / Doanh Nghiệp"
                                                           style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                                  -fx-border-color: #333; -fx-background-color: white;
                                                                  -fx-padding: 10 10 10 15;">
                                                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                                                </TextField>
                                                <TextField fx:id="txtSellerStoreName"
                                                           prefHeight="40" prefWidth="315.0"
                                                           promptText="Tên Cửa Hàng"
                                                           style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                                  -fx-border-color: #333; -fx-background-color: white;
                                                                  -fx-padding: 10 10 10 15;">
                                                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                                                </TextField>
                                                <TextField fx:id="txtSellerEmail"
                                                           prefHeight="40" prefWidth="315.0"
                                                           promptText="Email"
                                                           style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                                  -fx-border-color: #333; -fx-background-color: white;
                                                                  -fx-padding: 10 10 10 15;">
                                                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                                                </TextField>
                                                <PasswordField fx:id="txtSellerPassword"
                                                               prefHeight="40" prefWidth="315.0"
                                                               promptText="Mật Khẩu"
                                                               style="-fx-background-radius: 10; -fx-border-radius: 10;
                                                                      -fx-border-color: #333; -fx-background-color: white;
                                                                      -fx-padding: 10 10 10 15;">
                                                    <VBox.margin><Insets left="30.0" right="30.0" /></VBox.margin>
                                                </PasswordField>
                                                <Button onAction="#handleRegister"
                                                        prefHeight="41.0" prefWidth="180.0"
                                                        text="Đăng Ký"
                                                        style="-fx-background-color: #0ea5e9; -fx-text-fill: white;
                                                               -fx-font-weight: bold; -fx-background-radius: 20;
                                                               -fx-padding: 12; -fx-cursor: hand;">
                                                    <VBox.margin><Insets left="30.0" top="10.0" /></VBox.margin>
                                                </Button>
                                                <Label text="* Admin sẽ duyệt hồ sơ của bạn trong 24h"
                                                       style="-fx-font-size: 11px; -fx-font-style: italic;
                                                              -fx-text-fill: #64748b;">
                                                    <VBox.margin><Insets left="30.0" /></VBox.margin>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </content>
                                </Tab>

                            </tabs>
                        </TabPane>

                    </children>
                </VBox>

            </children>
        </VBox>

    </children>
</StackPane>
