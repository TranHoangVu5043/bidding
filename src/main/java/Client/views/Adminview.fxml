                            <VBox alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 14 18; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2); -fx-border-color: #F0FDF4; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
