                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <StackPane>
                                                <Rectangle arcHeight="10" arcWidth="10" fill="#ECFDF5" height="36" width="36" />
                                                <Label style="-fx-font-size: 16;" text="💰" />
                                            </StackPane>
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Doanh thu" />
                                        </HBox>
                                        <Label fx:id="lblTotalRevenue" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #16A34A;" text="--" />
                                    </VBox>

                                    <!-- Users -->
                                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,3); -fx-padding: 18 20;" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <StackPane>
                                                <Rectangle arcHeight="10" arcWidth="10" fill="#EFF6FF" height="36" width="36" />
                                                <Label style="-fx-font-size: 16;" text="👥" />
                                            </StackPane>
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Người dùng" />
                                        </HBox>
                                        <Label fx:id="lblTotalUsers" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #2563EB;" text="--" />
                                    </VBox>

                                    <!-- Sellers -->
                                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,3); -fx-padding: 18 20;" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <StackPane>
                                                <Rectangle arcHeight="10" arcWidth="10" fill="#FFF7ED" height="36" width="36" />
