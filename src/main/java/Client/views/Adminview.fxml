                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Người bán" />
                                        </HBox>
                                        <Label fx:id="lblTotalSellers" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #EA580C;" text="--" />
                                    </VBox>

                                    <!-- Auctions -->
                                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,3); -fx-padding: 18 20;" HBox.hgrow="ALWAYS">
                                        <HBox alignment="CENTER_LEFT" spacing="10">
                                            <StackPane>
                                                <Rectangle arcHeight="10" arcWidth="10" fill="#F5F3FF" height="36" width="36" />
                                                <Label style="-fx-font-size: 16;" text="🔨" />
                                            </StackPane>
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Phiên đấu giá" />
                                        </HBox>
                                        <Label fx:id="lblTotalAuctions" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #7C3AED;" text="--" />
                                    </VBox>

                                </HBox>

                                <!-- Activity feed + PieChart -->
                                <HBox spacing="16" VBox.vgrow="ALWAYS">

                                    <!-- Activity feed -->
