                                    <Label style="-fx-font-size: 14;" text="💰" />
                                    <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11; -fx-font-weight: bold;" text="ĐÃ BÁN" />
                                </HBox>
                                <Label fx:id="lblPendingItems" style="-fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #D97706;" text="—" />
                            </VBox>
                            <VBox alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 14 18; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2); -fx-border-color: #FFF1F2; -fx-border-radius: 12; -fx-border-width: 1;" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Rectangle arcHeight="8" arcWidth="8" fill="#FECDD3" height="28" width="28" />
                                    <Label style="-fx-font-size: 14;" text="🗑" />
                                    <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11; -fx-font-weight: bold;" text="KHÔNG HOẠT ĐỘNG" />
                                </HBox>
                                <Label fx:id="lblRemovedItems" style="-fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #DC2626;" text="—" />
                            </VBox>
                        </HBox>

                        <!-- Toolbar -->
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 14 18; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),6,0,0,2);">
                            <StackPane>
                                <TextField fx:id="txtProductSearch" prefWidth="290" promptText="  Tìm sản phẩm..." style="-fx-background-radius: 8; -fx-padding: 9 9 9 36; -fx-background-color: #F8FAFC; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1;" />
                                <Label alignment="CENTER_LEFT" style="-fx-font-size: 13; -fx-padding: 0 0 0 10;" text="🔍" />
                            </StackPane>
                            <ComboBox fx:id="cmbProductCategory" prefWidth="155" promptText="📂  Danh mục" style="-fx-background-radius: 8; -fx-background-color: #F8FAFC; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 1;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleCancelProduct" style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: #FECACA; -fx-border-radius: 8; -fx-border-width: 1;" text="🗑  Xóa sản phẩm" />
                        </HBox>

                        <!-- Table -->
                        <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,3);" VBox.vgrow="ALWAYS">
                            <TableView fx:id="tblItems" style="-fx-background-color: transparent; -fx-background-radius: 14; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colItemId" prefWidth="60" style="-fx-alignment: CENTER;" text="ID" />
                                    <TableColumn fx:id="colItemName" prefWidth="265" text="Tên sản phẩm" />
                                    <TableColumn fx:id="colItemCategory" prefWidth="145" style="-fx-alignment: CENTER;" text="Danh mục" />
                                    <TableColumn fx:id="colItemPrice" prefWidth="145" style="-fx-alignment: CENTER_RIGHT;" text="Giá bán (VNĐ)" />
                                    <TableColumn fx:id="colItemStock" prefWidth="100" style="-fx-alignment: CENTER;" text="Kho" />
                                </columns>
                            </TableView>
                        </VBox>

                    </VBox>
                </Tab>

                <!-- ══════════════════════════════
                     TAB: AUCTIONS
                ══════════════════════════════ -->
                <Tab fx:id="tabAuctions" text="">
                    <VBox spacing="16" style="-fx-padding: 24;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 18;" text="🔨" />
                            <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #0F1F35;" text="Quản Lý Đấu Giá" />
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 12 16; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),6,0,0,2);">
                            <TextField fx:id="txtAuctionSearch" prefWidth="280" promptText="🔍  Tìm phiên đấu giá..." style="-fx-background-radius: 8; -fx-padding: 9; -fx-background-color: #F8FAFC; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1;" />
                            <ComboBox fx:id="cmbAuctionStatus" prefWidth="150" promptText="Trạng thái" style="-fx-background-radius: 8; -fx-background-color: #F8FAFC;" />
                            <Region HBox.hgrow="ALWAYS" />
                        </HBox>
                        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="auctionsAdminFlowPane" hgap="16" style="-fx-padding: 4 0 16 0;" vgap="16" />
                            </content>
                        </ScrollPane>
                    </VBox>
                </Tab>

                <!-- ══════════════════════════════
                     TAB: SETTINGS
                ══════════════════════════════ -->
                <Tab fx:id="tabSettings" text="">
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <content>
                            <VBox spacing="20" style="-fx-padding: 24; -fx-max-width: 660;">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label style="-fx-font-size: 18;" text="⚙" />
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #0F1F35;" text="Cài Đặt Hệ Thống" />
                                </HBox>
                                <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 24; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,3);">
                                    <HBox alignment="CENTER_LEFT" spacing="8">
                                        <Label style="-fx-font-size: 15;" text="🔐" />
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #0F1F35;" text="Bảo mật tài khoản" />
                                    </HBox>
                                    <Separator opacity="0.5" />
                                    <VBox spacing="6">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12; -fx-font-weight: bold;" text="Mật khẩu hiện tại" />
                                        <PasswordField fx:id="txtAdminOldPw" style="-fx-background-radius: 8; -fx-padding: 10; -fx-background-color: #F8FAFC; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1;" />
                                    </VBox>
                                    <HBox spacing="16">
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12; -fx-font-weight: bold;" text="Mật khẩu mới" />
                                            <PasswordField fx:id="txtAdminNewPw" style="-fx-background-radius: 8; -fx-padding: 10; -fx-background-color: #F8FAFC; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1;" />
                                        </VBox>
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12; -fx-font-weight: bold;" text="Xác nhận mật khẩu" />
                                            <PasswordField fx:id="txtAdminConfirmPw" style="-fx-background-radius: 8; -fx-padding: 10; -fx-background-color: #F8FAFC; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1;" />
                                        </VBox>
                                    </HBox>
                                    <Button onAction="#handleChangeAdminPw" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 11 28; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian,rgba(37,99,235,0.3),6,0,0,2);" text="💾  Lưu mật khẩu" />
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </Tab>

            </TabPane>
        </VBox>
    </center>

</BorderPane>
