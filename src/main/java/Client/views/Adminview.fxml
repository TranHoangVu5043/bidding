                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label style="-fx-font-size: 15;" text="🕐" />
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #0F1F35;" text="Hoạt động gần đây" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF; -fx-background-color: #F3F4F6; -fx-background-radius: 20; -fx-padding: 3 10;" text="5 phiên gần nhất" />
                                        </HBox>

                                        <Separator opacity="0.5" />

                                        <ScrollPane fitToWidth="true" prefHeight="300" style="-fx-background: transparent; -fx-background-color: transparent; -fx-padding: 0;">
                                            <content>
                                                <VBox fx:id="activityVBox" spacing="10" style="-fx-padding: 2 2;" />
                                            </content>
                                        </ScrollPane>
                                    </VBox>

                                    <!-- Custom Donut Chart -->
                                    <VBox prefWidth="420" spacing="12" style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),10,0,0,3); -fx-padding: 20;">
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label style="-fx-font-size: 15;" text="📊" />
                                            <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #0F1F35;" text="Phân bố đấu giá" />
                                        </HBox>
                                        <Separator opacity="0.5" />
                                        <StackPane alignment="CENTER">
                                            <Canvas fx:id="chartCanvas" height="220.0" width="220.0" />
                                            <VBox alignment="CENTER" spacing="2" style="-fx-padding: 0;" mouseTransparent="true">
                                                <Label fx:id="chartCenterCount" style="-fx-font-weight: bold; -fx-font-size: 28; -fx-text-fill: #0F1F35;" text="0" />
                                                <Label style="-fx-font-size: 11; -fx-text-fill: #9CA3AF;" text="phiên đấu giá" />
                                            </VBox>
                                        </StackPane>
                                        <VBox fx:id="chartLegend" spacing="8" style="-fx-padding: 4 0 0 0;" />
                                    </VBox>

                                </HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </Tab>

                <!-- ══════════════════════════════
                     TAB: USERS
                ══════════════════════════════ -->
