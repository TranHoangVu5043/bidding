                                    <Label style="-fx-text-fill: #6B7280; -fx-font-size: 11; -fx-font-weight: bold;" text="TỔNG NGƯỜI DÙNG" />
                                </HBox>
                                <Label fx:id="lblUserCount" style="-fx-font-weight: bold; -fx-font-size: 22; -fx-text-fill: #2563EB;" text="—" />
