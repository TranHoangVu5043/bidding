<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1160.0" style="-fx-background-color: #F0F4F8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controller.admin.AdminDashboardController" stylesheets="@charts.css">

    <!-- ═══════════════════════════════════════════════════════
         SIDEBAR
    ════════════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="220.0" spacing="3.0" style="-fx-background-color: #0F1F35;">
            <padding><Insets bottom="24" left="14" right="14" top="24" /></padding>
            <children>

                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <padding><Insets bottom="4" left="4" /></padding>
                    <Label style="-fx-font-size: 24;" text="🔨" />
                    <VBox spacing="0">
                        <Label text="BIDMASTER" textFill="WHITE">
                            <font><Font name="System Bold" size="15.0" /></font>
                        </Label>
                        <Label style="-fx-font-size: 10; -fx-text-fill: #4A90D9;" text="Admin Portal" />
                    </VBox>
                </HBox>

                <Separator opacity="0.15">
                    <VBox.margin><Insets bottom="12" top="14" /></VBox.margin>
                </Separator>

                <!-- Admin profile card -->
                <VBox alignment="CENTER" spacing="6" style="-fx-background-color: rgba(255,255,255,0.05); -fx-background-radius: 12; -fx-padding: 16; -fx-border-color: rgba(255,255,255,0.08); -fx-border-radius: 12; -fx-border-width: 1;">
                    <StackPane>
                        <Circle fill="#1a4a7a" radius="30.0" stroke="#2ecc71" strokeWidth="2.5" />
                        <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2ecc71;" text="A" />
                    </StackPane>
                    <Label fx:id="welcomeLabel" style="-fx-font-weight: bold; -fx-font-size: 13;" text="Admin" textFill="WHITE" />
                    <HBox alignment="CENTER" spacing="5">
                        <Circle fill="#2ecc71" radius="4.0" />
                        <Label style="-fx-font-size: 10; -fx-text-fill: #2ecc71; -fx-font-weight: bold;" text="ADMINISTRATOR" />
                    </HBox>
                    <VBox.margin><Insets bottom="4" /></VBox.margin>
                </VBox>

                <Separator opacity="0.15">
                    <VBox.margin><Insets bottom="8" top="12" /></VBox.margin>
                </Separator>

                <!-- Nav label -->
                <Label style="-fx-font-size: 10; -fx-text-fill: #4A6080; -fx-font-weight: bold; -fx-padding: 0 0 4 6;" text="MENU" />

                <!-- Nav buttons -->
                <Button fx:id="btnHome" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleHome" style="-fx-background-color: #2ecc71; -fx-background-radius: 9; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 11 14; -fx-cursor: hand; -fx-effect: dropshadow(gaussian,rgba(46,204,113,0.35),8,0,0,3);" text="🏠   Dashboard" textFill="WHITE" />

                <Button fx:id="btnUsers" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleUsers" style="-fx-background-color: transparent; -fx-background-radius: 9; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 11 14; -fx-cursor: hand;" text="👥   User" textFill="#94A3B8" />

                <Button fx:id="btnInventory" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleInventory" style="-fx-background-color: transparent; -fx-background-radius: 9; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 11 14; -fx-cursor: hand;" text="📦   Inventory" textFill="#94A3B8" />

                <Button fx:id="btnAuctions" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleAuctions" style="-fx-background-color: transparent; -fx-background-radius: 9; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 11 14; -fx-cursor: hand;" text="🔨   Auction" textFill="#94A3B8" />

                <Button fx:id="btnSettings" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSettings" style="-fx-background-color: transparent; -fx-background-radius: 9; -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 11 14; -fx-cursor: hand;" text="⚙   Setting" textFill="#94A3B8" />

                <Region VBox.vgrow="ALWAYS" />
                <Separator opacity="0.15" />

                <Button fx:id="btnSignOut" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSignOut" style="-fx-background-color: rgba(192,57,43,0.15); -fx-background-radius: 9; -fx-font-size: 13; -fx-padding: 11 14; -fx-cursor: hand; -fx-border-color: rgba(192,57,43,0.3); -fx-border-radius: 9; -fx-border-width: 1;" text="🚪   Đăng xuất" textFill="#E74C3C">
                    <VBox.margin><Insets top="8" /></VBox.margin>
                </Button>

            </children>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════════
         MAIN CONTENT
    ════════════════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0">

            <!-- Top bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="58" spacing="12" style="-fx-background-color: white; -fx-border-color: #E8EDF2; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.04),6,0,0,2);">
                <padding><Insets left="24" right="24" /></padding>
                <Label fx:id="lblPageTitle" style="-fx-font-weight: bold; -fx-font-size: 17; -fx-text-fill: #0F1F35;" text="Dashboard" />
                <Region HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- TabPane -->
            <TabPane fx:id="mainTabPane" style="-fx-tab-min-width: 0; -fx-tab-max-width: 0; -fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                <!-- ══════════════════════════════
                     TAB: DASHBOARD
                ══════════════════════════════ -->
                <Tab fx:id="tabDashboard" text="">
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <content>
                            <VBox spacing="20" style="-fx-padding: 24;">

                                <!-- KPI cards -->
                                <HBox spacing="16">

                                    <!-- Revenue -->
