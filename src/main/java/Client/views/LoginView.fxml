<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
  Root changed to StackPane so the login card stays centred when the window
  is resized.  The two-panel HBox (image + form) is centred automatically.
-->
<StackPane style="-fx-background-color: #f0f4f8;"
    xmlns="http://javafx.com/javafx/22"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="Client.controller.auth.LoginController">
    <children>

        <!-- ── Login card ── -->
        <HBox style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 24, 0, 0, 6);
                     -fx-background-radius: 16;"
              maxHeight="456" maxWidth="762">

            <!-- Left panel: illustration -->
            <AnchorPane prefWidth="381.0" prefHeight="456.0"
                        style="-fx-background-color: #FFFFFF;
                               -fx-background-radius: 16 0 0 16;">
                <children>
                    <ImageView fitHeight="448.0" fitWidth="381.0"
                               layoutX="1.0" layoutY="3.0" pickOnBounds="false">
                        <image><Image url="@login_bg.png" /></image>
                    </ImageView>
                </children>
            </AnchorPane>

            <!-- Right panel: form -->
            <VBox prefWidth="381.0" prefHeight="456.0" alignment="CENTER" spacing="0"
                  style="-fx-background-color: #1a337e;
                         -fx-background-radius: 0 16 16 0;
                         -fx-padding: 40 40 30 40;">
                <children>

                    <Label text="Hello!" textFill="WHITE">
                        <font><Font name="System Bold" size="32.0" /></font>
                        <VBox.margin><Insets bottom="4" /></VBox.margin>
                    </Label>

                    <Label text="Welcome back!" textFill="WHITE">
                        <font><Font name="System Bold" size="22.0" /></font>
                        <VBox.margin><Insets bottom="4" /></VBox.margin>
                    </Label>

                    <Label text="Let's Login to Your Account"
                           textFill="#cfcfcf" style="-fx-font-size: 13;">
                        <VBox.margin><Insets bottom="28" /></VBox.margin>
                    </Label>

                    <Label text="Username" textFill="WHITE" style="-fx-font-size: 13;">
                        <VBox.margin><Insets bottom="4" /></VBox.margin>
                    </Label>
                    <TextField fx:id="txtUserName"
                               onAction="#showUserName"
                               prefHeight="40.0"
                               promptText="Username"
                               style="-fx-background-radius: 8; -fx-padding: 8 12;">
                        <VBox.margin><Insets bottom="16" /></VBox.margin>
                    </TextField>

                    <Label text="Password" textFill="WHITE" style="-fx-font-size: 13;">
                        <VBox.margin><Insets bottom="4" /></VBox.margin>
                    </Label>
                    <PasswordField fx:id="txtPassword"
                                   onAction="#showPassWord"
                                   prefHeight="40.0"
                                   promptText="Password"
                                   style="-fx-background-radius: 8; -fx-padding: 8 12;">
                        <VBox.margin><Insets bottom="28" /></VBox.margin>
                    </PasswordField>

                    <Button fx:id="btnLogin"
                            onAction="#handleLogin"
                            mnemonicParsing="false"
                            prefHeight="45.0" maxWidth="Infinity"
                            text="Login" textFill="WHITE"
                            style="-fx-background-color: #FF7F00;
                                   -fx-background-radius: 25;
                                   -fx-cursor: hand;">
                        <font><Font name="System Bold" size="16.0" /></font>
                        <VBox.margin><Insets bottom="20" /></VBox.margin>
                    </Button>

                    <HBox alignment="CENTER" spacing="4">
                        <Label text="Don't have an account?" textFill="#bcbcbc"
                               style="-fx-font-size: 12;" />
                        <Hyperlink fx:id="Sign"
                                   onAction="#handleNavigateToRegister"
                                   text="Sign In now" textFill="WHITE"
                                   style="-fx-underline: true; -fx-font-size: 12;" />
                    </HBox>

                </children>
            </VBox>

        </HBox>
    </children>
</StackPane>
