<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" style="-fx-background-color: #F9FAFB;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.controller.seller.SellerController">

    <!-- ═══════════════════ LEFT SIDEBAR ═══════════════════ -->
    <left>
        <VBox prefWidth="200.0" spacing="4.0" style="-fx-background-color: #1a3a5a;">
            <padding><Insets bottom="20" left="12" right="12" top="20" /></padding>
            <children>

                <VBox alignment="CENTER" spacing="6" style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 10; -fx-padding: 14;">
                    <Circle fill="#f97316" radius="28.0" stroke="#ea580c" strokeWidth="2" />
                    <Label fx:id="lblShopName" style="-fx-font-weight: bold; -fx-font-size: 13;" text="My Shop" textFill="WHITE" />
                    <Label style="-fx-font-size: 10; -fx-text-fill: #f97316;" text="● SELLER" />
                    <VBox.margin><Insets bottom="6" /></VBox.margin>
                </VBox>

                <Separator opacity="0.2">
                    <VBox.margin><Insets bottom="6" top="6" /></VBox.margin>
                </Separator>

                <Button fx:id="btnDashboard" maxWidth="Infinity" mnemonicParsing="false" onAction="#showDashboard" style="-fx-background-color: #f97316; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="🏠  Dashboard" textFill="WHITE" />

                <Button fx:id="btnInventory" maxWidth="Infinity" mnemonicParsing="false" onAction="#showInventory" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="📦  Inventory" textFill="#CBD5E1" />

                <Button fx:id="btnAddProduct" maxWidth="Infinity" mnemonicParsing="false" onAction="#showAddProduct" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="➕  Add Product" textFill="#CBD5E1" />

                <Button fx:id="btnAuctions" maxWidth="Infinity" mnemonicParsing="false" onAction="#showAuctions" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="🔨  Auctions" textFill="#CBD5E1" />

                <Button fx:id="btnOrders" maxWidth="Infinity" mnemonicParsing="false" onAction="#showOrders" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="🧾  Orders" textFill="#CBD5E1" />

                <Button fx:id="btnRevenue" maxWidth="Infinity" mnemonicParsing="false" onAction="#showRevenue" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="📊  Revenue" textFill="#CBD5E1" />

                <Button fx:id="btnHistory" maxWidth="Infinity" mnemonicParsing="false" onAction="#showHistory" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="📜  History" textFill="#CBD5E1" />

                <Button fx:id="btnProfile" maxWidth="Infinity" mnemonicParsing="false" onAction="#showProfile" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-alignment: CENTER_LEFT; -fx-padding: 10 14;" text="👤  Profile" textFill="#CBD5E1" />

                <Region VBox.vgrow="ALWAYS" />
                <Separator opacity="0.2" />

                <Button fx:id="btnLogout" maxWidth="Infinity" mnemonicParsing="false" onAction="#showLogout" style="-fx-background-color: #C0392B; -fx-background-radius: 8;                                -fx-font-size: 13; -fx-padding: 10 14; -fx-cursor: hand;" text="🚪  Logout" textFill="WHITE">
                    <VBox.margin><Insets top="6" /></VBox.margin>
                </Button>

            </children>
        </VBox>
    </left>

    <!-- ═══════════════════ CENTER ═══════════════════ -->
    <center>
        <VBox spacing="0">

            <!-- Top bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="56" spacing="12" style="-fx-background-color: white;                          -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
                <padding><Insets left="20" right="20" /></padding>
                <Label fx:id="lblPageTitle" style="-fx-font-weight: bold; -fx-font-size: 17;" text="Dashboard" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="6" style="-fx-cursor: hand;">
                    <Circle fill="#f97316" radius="16.0" stroke="#fed7aa" strokeWidth="2" />
                    <Label fx:id="lblSellerName" style="-fx-font-weight: bold; -fx-font-size: 13;" text="My Shop" />
                </HBox>
            </HBox>

            <!-- Hidden TabPane -->
            <TabPane fx:id="mainTabPane" style="-fx-tab-min-width: 0; -fx-tab-max-width: 0; -fx-background-color: transparent;" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                <!-- TAB: DASHBOARD -->
                <Tab fx:id="tabDashboard" text="">
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                        <content>
                            <VBox spacing="20" style="-fx-padding: 22;">
                                <HBox spacing="14">
                                    <VBox prefHeight="88" prefWidth="185" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12;                                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 16;">
                                        <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Doanh thu tháng này" />
                                        <Label fx:id="lblMonthRevenue" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #16A34A;" text="45,200,000 ₫" />
                                        <Label style="-fx-font-size: 10; -fx-text-fill: #16A34A;" text="▲ 18% so với tháng trước" />
                                    </VBox>
                                    <VBox prefHeight="88" prefWidth="185" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12;                                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 16;">
                                        <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đơn hàng mới" />
                                        <Label fx:id="lblNewOrders" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #0066CC;" text="24 đơn" />
                                        <Label style="-fx-font-size: 10; -fx-text-fill: #0066CC;" text="▲ 5 đơn so với hôm qua" />
                                    </VBox>
                                    <VBox prefHeight="88" prefWidth="185" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12;                                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 16;">
                                        <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Sản phẩm đang bán" />
                                        <Label fx:id="lblActiveProducts" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #f97316;" text="38 sản phẩm" />
                                        <Label style="-fx-font-size: 10; -fx-text-fill: #e74c3c;" text="3 sắp hết hàng" />
                                    </VBox>
                                    <VBox prefHeight="88" prefWidth="185" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12;                                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 16;">
                                        <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Phiên đấu giá" />
                                        <Label fx:id="lblActiveAuctions" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #8B5CF6;" text="5 đang chạy" />
                                        <Label style="-fx-font-size: 10; -fx-text-fill: #9CA3AF;" text="2 kết thúc hôm nay" />
                                    </VBox>
                                </HBox>

                                <HBox spacing="14">
                                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;" HBox.hgrow="ALWAYS">
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Doanh thu 7 ngày gần nhất" />
                                        <LineChart fx:id="chartWeekRevenue" prefHeight="261.0" prefWidth="570.0">
                                            <xAxis><CategoryAxis /></xAxis>
                                            <yAxis><NumberAxis /></yAxis>
                                        </LineChart>
                                    </VBox>
                                    <VBox prefWidth="240" spacing="8" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Danh mục sản phẩm" />
                                        <PieChart fx:id="chartCategories" prefHeight="210" prefWidth="220" />
                                    </VBox>
                                </HBox>

                                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;" />
                            </VBox>
                        </content>
                    </ScrollPane>
                </Tab>

                <!-- TAB: INVENTORY -->
                <Tab fx:id="tabInventory" text="">
                    <VBox spacing="15" style="-fx-padding: 22;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="📦 Kho Hàng" />
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="txtSearch" onAction="#handleSearch" prefWidth="280" promptText="Tìm tên sản phẩm..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                            <ComboBox fx:id="cmbInvStatus" prefWidth="140" promptText="Trạng thái" style="-fx-background-radius: 8;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#showAddProduct" style="-fx-background-color: #f97316; -fx-text-fill: white;                                            -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;                                            -fx-font-weight: bold;" text="+ Thêm sản phẩm" />
                        </HBox>
                        <TableView fx:id="tableMyItems" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                                <TableColumn fx:id="colName" prefWidth="220" text="Tên sản phẩm" />
                                <TableColumn fx:id="colPrice" prefWidth="120" text="Giá (₫)" />
                                <TableColumn fx:id="colStock" prefWidth="100" text="Tồn kho" />
                                <TableColumn fx:id="colCategory" prefWidth="130" text="Danh mục" />
                                <TableColumn fx:id="colStatus" prefWidth="110" text="Trạng thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Form đăng đấu giá nhanh -->
                        <HBox alignment="CENTER_LEFT" spacing="10"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 12;
                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2);">
                            <Label text="Đăng đấu giá:" style="-fx-font-weight: bold;" />
                            <Label fx:id="lblSelectedProduct" text="Chưa chọn sản phẩm"
                                   style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label text="Giá khởi điểm (₫):" style="-fx-font-weight: bold;" />
                            <TextField fx:id="txtAuctionPrice" prefWidth="150" promptText="Nhập giá..."
                                       style="-fx-background-radius: 8; -fx-padding: 8;" />
                            <Label text="Ngày kết thúc:" style="-fx-font-weight: bold;" />
                            <DatePicker fx:id="dpAuctionEndDate" prefWidth="160" promptText="Chọn ngày..." />
                            <Button text="🚀 Đăng đấu giá" onAction="#handleQuickAuction"
                                    style="-fx-background-color: #f97316; -fx-text-fill: white;
                                           -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18; -fx-cursor: hand;" />
                        </HBox>
                    </VBox>
                </Tab>

                <!-- TAB: ADD PRODUCT -->
                <Tab fx:id="tabAddProduct" text="">
                    <ScrollPane fitToWidth="true" style="-fx-background: white; -fx-background-color: white;">
                        <content>
                            <VBox spacing="22" style="-fx-padding: 28; -fx-max-width: 700;">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="➕ Thêm Sản Phẩm Mới" />

                                <VBox spacing="14" style="-fx-background-color: #FAFAFA; -fx-background-radius: 10; -fx-padding: 18;">
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #f97316;" text="Thông tin cơ bản" />
                                    <GridPane hgap="15" vgap="12">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="130" prefWidth="130" />
                                            <ColumnConstraints hgrow="ALWAYS" />
                                        </columnConstraints>
                                        <rowConstraints>
                                            <RowConstraints /><RowConstraints />
                                            <RowConstraints /><RowConstraints />
                                            <RowConstraints /><RowConstraints />
                                        </rowConstraints>
                                        <children>
                                            <Label style="-fx-font-size: 13;" text="Tên sản phẩm:" GridPane.rowIndex="0" />
                                            <TextField fx:id="txtName" promptText="Nhập tên sản phẩm..." style="-fx-background-radius: 8; -fx-padding: 9;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                            <Label style="-fx-font-size: 13;" text="Danh mục:" GridPane.rowIndex="1" />
                                            <ComboBox fx:id="cmbCategory" maxWidth="Infinity" promptText="Chọn danh mục..." style="-fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                            <Label style="-fx-font-size: 13;" text="Tình trạng:" GridPane.rowIndex="2" />
                                            <ComboBox fx:id="cmbCondition" maxWidth="Infinity" promptText="Chọn tình trạng..." style="-fx-background-radius: 8;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                            <Label style="-fx-font-size: 13;" text="Giá bán (₫):" GridPane.rowIndex="3" />
                                            <TextField fx:id="txtPrice" maxWidth="200" promptText="0" style="-fx-background-radius: 8; -fx-padding: 9;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                            <Label style="-fx-font-size: 13;" text="Số lượng tồn kho:" GridPane.rowIndex="4" />
                                            <TextField fx:id="txtStock" maxWidth="120" promptText="0" style="-fx-background-radius: 8; -fx-padding: 9;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                            <Label style="-fx-font-size: 13;" text="Mô tả:" GridPane.rowIndex="5" />
                                            <TextArea fx:id="txtDescription" prefHeight="80" promptText="Mô tả sản phẩm..." style="-fx-background-radius: 8;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                        </children>
                                    </GridPane>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="12">
                                    <Button onAction="#showCancel" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                                    -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand;" text="Hủy" />
                                    <Button onAction="#handleAddProduct" style="-fx-background-color: #f97316; -fx-text-fill: white;                                                    -fx-font-weight: bold; -fx-background-radius: 8;                                                    -fx-padding: 10 24; -fx-cursor: hand;" text="Thêm sản phẩm" />
                                </HBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </Tab>

                <!-- TAB: AUCTIONS -->
                <Tab fx:id="tabAuctions" text="">
                    <VBox spacing="15" style="-fx-padding: 22;">

                        <!-- Tiêu đề -->
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="🔨 Đấu Giá" />

                        <!-- Thống kê nhanh -->
                        <HBox spacing="14">
                            <VBox prefHeight="76" prefWidth="180" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12;                          -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 14;">
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đang hoạt động" />
                                <Label fx:id="lblSellerActiveAuctions" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #8B5CF6;" text="0" />
                            </VBox>
                            <VBox prefHeight="76" prefWidth="180" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12;                          -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 14;">
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Đã kết thúc" />
                                <Label fx:id="lblSellerEndedAuctions" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #6B7280;" text="0" />
                            </VBox>
                            <VBox prefHeight="76" prefWidth="200" spacing="4" style="-fx-background-color: white; -fx-background-radius: 12;                          -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 14;">
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Tổng doanh thu đấu giá" />
                                <Label fx:id="lblSellerTotalRevenue" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #16A34A;" text="0 ₫" />
                            </VBox>
                        </HBox>

                        <!-- Thanh tìm kiếm & lọc -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="txtAuctionSearch" prefWidth="300" promptText="Tìm theo mã đấu giá, mã sản phẩm..." style="-fx-background-radius: 8; -fx-padding: 8;" />
                            <ComboBox fx:id="cmbAuctionStatus" prefWidth="160" promptText="Trạng thái" style="-fx-background-radius: 8;" />
                        </HBox>

                        <!-- Bảng danh sách đấu giá -->
                        <TableView fx:id="tableSellerAuctions" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colSAucId" prefWidth="80" text="Mã ĐG" />
                                <TableColumn fx:id="colSAucItem" prefWidth="100" text="ID" />
                                <TableColumn fx:id="colSAucStartPrice" prefWidth="150" text="Giá khởi điểm (₫)" />
                                <TableColumn fx:id="colSAucCurrentPrice" prefWidth="150" text="Giá hiện tại (₫)" />
                                <TableColumn fx:id="colSAucEndTime" prefWidth="170" text="Thời gian kết thúc" />
                                <TableColumn fx:id="colSAucStatus" prefWidth="120" text="Trạng thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                    </VBox>
                </Tab>

                <!-- TAB: ORDERS -->
                <Tab fx:id="tabOrders" text="">
                    <VBox spacing="15" style="-fx-padding: 22;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="🧾 Đơn Hàng" />

                        <TableView fx:id="tableRecentOrders" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colROId" prefWidth="110" text="Mã đơn" />
                                <TableColumn fx:id="colROProduct" prefWidth="180" text="Sản phẩm" />
                                <TableColumn fx:id="colROTotal" prefWidth="120" text="Tổng tiền" />
                                <TableColumn fx:id="colROStatus" prefWidth="110" text="Trạng thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- TAB: REVENUE -->
                <Tab fx:id="tabRevenue" text="">
                    <VBox spacing="15" style="-fx-padding: 22;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="📊 Doanh Thu" />

                        <!-- Thống kê tổng hợp -->
                        <HBox spacing="14">
                            <VBox prefHeight="88" prefWidth="200" spacing="4"
                                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 16;">
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Tổng doanh thu" />
                                <Label fx:id="lblRevTotal" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #16A34A;" text="0 ₫" />
                            </VBox>
                            <VBox prefHeight="88" prefWidth="180" spacing="4"
                                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 16;">
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Phiên đã kết thúc" />
                                <Label fx:id="lblRevEnded" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #6B7280;" text="0" />
                            </VBox>
                            <VBox prefHeight="88" prefWidth="180" spacing="4"
                                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,2); -fx-padding: 16;">
                                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 12;" text="Phiên đang chạy" />
                                <Label fx:id="lblRevActive" style="-fx-font-weight: bold; -fx-font-size: 18; -fx-text-fill: #8B5CF6;" text="0" />
                            </VBox>
                        </HBox>

                        <!-- BarChart doanh thu theo tháng -->
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Doanh thu theo tháng" />
                        <BarChart fx:id="chartRevByMonth" animated="true" prefHeight="260" VBox.vgrow="NEVER"
                                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 10;">
                            <xAxis>
                                <CategoryAxis label="Tháng" />
                            </xAxis>
                            <yAxis>
                                <NumberAxis label="Doanh thu (₫)" />
                            </yAxis>
                        </BarChart>

                        <!-- Bảng chi tiết auction đã kết thúc -->
                        <Label style="-fx-font-weight: bold; -fx-font-size: 13;" text="Chi tiết các phiên đấu giá đã kết thúc" />
                        <TableView fx:id="tableRevenue" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRevId"           prefWidth="80"  text="Mã ĐG" />
                                <TableColumn fx:id="colRevItem"         prefWidth="80"  text="Mã SP" />
                                <TableColumn fx:id="colRevStartPrice"   prefWidth="160" text="Giá khởi điểm (₫)" />
                                <TableColumn fx:id="colRevFinalPrice"   prefWidth="160" text="Giá cuối (₫)" />
                                <TableColumn fx:id="colRevEndTime"      prefWidth="180" text="Thời gian kết thúc" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- TAB: HISTORY -->
                <Tab fx:id="tabHistory" text="">
                    <VBox spacing="15" style="-fx-padding: 22;">
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="📜 Lịch Sử Giao Dịch" />
                        <TableView fx:id="tableHistory" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colHisId" prefWidth="150" text="Mã đơn" />
                                <TableColumn fx:id="colHisProduct" prefWidth="200" text="Sản phẩm" />
                                <TableColumn fx:id="colHisAmount" prefWidth="150" text="Số tiền (₫)" />
                                <TableColumn fx:id="colHisStatus" prefWidth="120" text="Trạng thái" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </Tab>

                <!-- TAB: PROFILE -->
                <Tab fx:id="tabProfile" text="">
                    <ScrollPane fitToWidth="true" style="-fx-background: transparent;">
                        <content>
                            <VBox spacing="20" style="-fx-padding: 22; -fx-max-width: 640;">
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="👤 Hồ Sơ Người Bán" />
                                <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #f97316;" text="Thông tin shop" />
                                    <Separator />
                                    <HBox spacing="15">
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Tên shop" />
                                            <TextField fx:id="txtShopName" promptText="Tên shop của bạn" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="SĐT liên hệ" />
                                            <TextField fx:id="txtSellerPhone" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                    </HBox>
                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mô tả shop" />
                                        <TextArea fx:id="txtShopDesc" prefHeight="70" style="-fx-background-radius: 8;" wrapText="true" />
                                    </VBox>
                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Địa chỉ" />
                                        <TextField fx:id="txtSellerAddress" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </VBox>
                                    <Button onAction="#handleSaveShop" style="-fx-background-color: #f97316; -fx-text-fill: white;                                                    -fx-font-weight: bold; -fx-background-radius: 8;                                                    -fx-padding: 10 24; -fx-cursor: hand;" text="Lưu thông tin shop" />
                                </VBox>

                                <VBox spacing="14" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 14;" text="Đổi mật khẩu" />
                                    <Separator />
                                    <VBox spacing="5">
                                        <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mật khẩu hiện tại" />
                                        <PasswordField fx:id="txtOldPw" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                    </VBox>
                                    <HBox spacing="15">
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Mật khẩu mới" />
                                            <PasswordField fx:id="txtNewPw" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                                            <Label style="-fx-text-fill: #6B7280; -fx-font-size: 12;" text="Xác nhận" />
                                            <PasswordField fx:id="txtConfirmPw" style="-fx-background-radius: 8; -fx-padding: 9;" />
                                        </VBox>
                                    </HBox>
                                    <Button onAction="#handleChangePw" style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;                                                    -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand;" text="Đổi mật khẩu" />
                                </VBox>
                            </VBox>
                        </content>
                    </ScrollPane>
                </Tab>

            </TabPane>
        </VBox>
    </center>

</BorderPane>
